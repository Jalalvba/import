MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=avis

# ── Google Drive (service account) ────────────────────────────────────────
# 1. In Google Cloud Console: create/select a project, enable the "Google
#    Drive API", then create a Service Account (IAM & Admin > Service
#    Accounts) and generate a JSON key for it (Keys > Add Key > JSON) —
#    this downloads a keyfile.json.
# 2. Base64-encode the entire key file onto a single line:
#      base64 -w 0 keyfile.json
#    Paste that single-line output as the value below.
# 3. Share the target Drive folder with the service account's email — found
#    inside the JSON key as "client_email" (looks like
#    <name>@<project>.iam.gserviceaccount.com) — with at least Viewer
#    access, or the folder listing will come back empty/403.
GOOGLE_SERVICE_ACCOUNT_KEY_B64=<base64 -w 0 keyfile.json>

# The target Drive folder's ID, taken from its URL:
# https://drive.google.com/drive/folders/<GOOGLE_DRIVE_FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=<folder-id-from-drive-url>
